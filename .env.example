FIREWORKS_API_KEY=fw_your_key_here
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro-0813
FIREWORKS_FAST_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
PREFER_FAST_MODEL=false
ANSWER_MAX_TOKENS=700
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
WHISPER_MODEL=tiny
MAX_UPLOAD_MB=500
RATE_LIMIT_PER_MINUTE=120
RAM_CACHE_TTL_SECONDS=600
RAM_CACHE_MAX_ENTRIES=64
RAM_CACHE_MAX_MB=48
# Optional desk lock — if set, clients must send X-API-Key
API_KEY=
# Optional Slack/Discord/webhook for 5xx alerts
ALERT_WEBHOOK_URL=
# Browser origins for Vercel UI (comma-separated, or * )
CORS_ORIGINS=*
# false on Render — YouTube blocks cloud downloads; captions-only
YOUTUBE_DOWNLOAD_FALLBACK=false
# Vercel serverless caption proxy (bypasses Render IP block)
YOUTUBE_CAPTION_PROXY=https://nexora-evidence.vercel.app/api/yt-captions
# YouTube on Render: paste Netscape cookies.txt OR set a residential proxy
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_FILE=
YOUTUBE_HTTP_PROXY=
